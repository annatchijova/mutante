# ─────────────────────────────────────────────────────────────────────────────
# MUTANTE — configuración multi-proveedor
# ─────────────────────────────────────────────────────────────────────────────
# MUTANTE ya no depende solo de Gemini. Cada rol del pipeline (TARGET, AGENT,
# EVALUATOR) puede apuntar a un proveedor distinto. Dos formas de configurarlo:
#
#   A) Prefijo proveedor/modelo en la variable de modelo (recomendado):
#        TARGET_MODEL="openai/gpt-4o"
#        TARGET_MODEL="anthropic/claude-3-5-sonnet-latest"
#        TARGET_MODEL="vertex/gemini-3-flash"
#        TARGET_MODEL="gemini/gemini-2.5-flash"     # Google AI Studio (API key)
#        TARGET_MODEL="ollama/llama3.1"             # endpoint local
#        TARGET_MODEL="groq/llama-3.1-70b-versatile"
#
#   B) Proveedor explícito + modelo:
#        TARGET_PROVIDER="openai"
#        TARGET_MODEL="gpt-4o"
#
# Prefijos soportados: vertex, gemini, openai, anthropic, azure, openrouter,
# groq, together, fireworks, deepseek, ollama, vllm, lmstudio.

# ── Rol TARGET (modelo bajo ataque) ──────────────────────────────────────────
TARGET_MODEL="vertex/gemini-3-flash"
# TARGET_PROVIDER=""   # opcional; se infiere del prefijo o de las API keys

# ── Rol AGENT (orquestador ADK) — por defecto = TARGET ───────────────────────
# AGENT_MODEL="vertex/gemini-3-flash"

# ── Rol EVALUATOR (juez semiótico LLM) ───────────────────────────────────────
EVALUATOR_MODEL="gemini/gemini-2.5-flash"

# ── Credenciales por proveedor (define solo las que uses) ────────────────────
# Vertex AI (Gemini vía GCP):
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
VERTEX_AI_LOCATION="us-central1"
# Google AI Studio (Gemini vía API key, sin GCP):
GEMINI_API_KEY=""
# OpenAI y compatibles (OpenRouter/Groq/Together/DeepSeek/Ollama/vLLM...):
OPENAI_API_KEY=""
# OPENAI_BASE_URL=""     # override para endpoints compatibles / Azure / local
# OPENAI_ORG=""
# Anthropic (Claude):
ANTHROPIC_API_KEY=""
# ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"

# ── Selección de mutaciones (opcional) ───────────────────────────────────────
# Lista separada por comas; si se omite se usa el set completo (MUTATIONS_V2).
# MUTANTE_MUTATIONS="rot13,base64_encode,atbash,caesar,ascii_smuggle,leetspeak"

# ── Telemetría / almacenamiento ──────────────────────────────────────────────
ELASTIC_CLOUD_ID="your-elastic-cloud-id"
ELASTIC_API_KEY="your-elastic-api-key"
